# Model provider: openai (any OpenAI-compatible endpoint), openrouter, anthropic
LLM_PROVIDER=openai
# Required for openai; optional for openrouter (defaults to
# https://openrouter.ai/api/v1) and anthropic (defaults to the Claude API).
LLM_BASE_URL=http://host01:9207/v1
LLM_API_KEY=sk-...
LLM_MODEL=zai-org/GLM-5.2

# OpenRouter example:
#   LLM_PROVIDER=openrouter
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=anthropic/claude-sonnet-4.5
# Claude API example:
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...
#   LLM_MODEL=claude-sonnet-4-5

# Sampling temperature. 0 = greedy decoding, which makes a run reproducible and
# matches the CITYWALK evaluation setup that bench/ reproduces. Raise it only
# when you deliberately want sampling variety.
LLM_TEMPERATURE=0

# Per-request timeout in seconds. Keep it near the slowest healthy response,
# not far above it: the client retries twice, so a hung request costs three
# times this value before it gives up. Measured against this endpoint a large
# prompt returns in under a second, and a 600 s timeout turned one hung request
# into 30 wasted minutes for that method.
LLM_TIMEOUT_SECONDS=180

# Super-step budget per agent run. One agent turn costs 3 LangGraph steps, so
# this allows roughly limit/3 tool calls; every subagent inherits the same
# budget for its own run. Raise it for large projects, lower it to fail fast.
AGENT_RECURSION_LIMIT=600

# Langfuse tracing (optional — leave unset to run without tracing).
# Keys: Langfuse UI -> Settings -> API Keys. EU cloud shown; US cloud is
# https://us.cloud.langfuse.com, or your self-hosted URL.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Separates dev/staging/production traces in the Langfuse UI.
LANGFUSE_TRACING_ENVIRONMENT=development
